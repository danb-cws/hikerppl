# Ordnance Survey Maps API key (https://osdatahub.os.uk).
# Optional — the OS premium layer is hidden until this is set.
VITE_OS_MAPS_API_KEY=

# Firebase config (used by the live-sync increment).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# Fixed email of the shared leader account (non-secret login identifier).
# The leader signs in with a display Name + the account password (not this email).
VITE_LEADER_EMAIL=
